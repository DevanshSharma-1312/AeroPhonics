/***************************************************
                 WEB RELAY CONTROL
***************************************************/

void handleToggle()
{
  if (!server.hasArg("relay"))
  {
    server.send(
      400,
      "text/plain",
      "Missing relay"
    );

    return;
  }


  int relay =
      server.arg("relay").toInt() - 1;


  if (relay < 0 || relay >= 5)
  {
    server.send(
      400,
      "text/plain",
      "Invalid relay"
    );

    return;
  }


  relayState[relay] =
      !relayState[relay];


  setRelay(
    relay,
    relayState[relay]
  );


  if (Firebase.ready())
  {
    String path =
        "/control/relay" +
        String(relay + 1);

    if (Firebase.RTDB.setBool(
          &fbdo,
          path,
          relayState[relay]))
    {
      Serial.print("Relay Firebase OK: ");
      Serial.println(path);
    }
    else
    {
      Serial.print("Relay Firebase ERROR: ");
      Serial.println(fbdo.errorReason());
    }
  }


  server.send(
    200,
    "text/plain",
    "OK"
  );
}


