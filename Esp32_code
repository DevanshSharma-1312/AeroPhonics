    ADC_11db
  );


  /***********************************************
                    RELAY SETUP
  ************************************************/

  for (int i = 0; i < 5; i++)
  {
    pinMode(
      relayPins[i],
      OUTPUT
    );

    digitalWrite(
      relayPins[i],
