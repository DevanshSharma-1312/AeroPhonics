/***************************************************
                      LOOP
***************************************************/

void loop()
{
  /***********************************************
                  WEB SERVER
  ************************************************/

  server.handleClient();


  /***********************************************
                   WIFI CHECK
  ************************************************/

  if (WiFi.status() != WL_CONNECTED)
  {
    Serial.println(
      "WiFi disconnected."
    );

    WiFi.reconnect();
  }


  /***********************************************
                  SENSOR UPDATE
  ************************************************/

  if (
    millis() - lastSensor
    >= SENSOR_INTERVAL
  )
  {
    lastSensor =
        millis();

    readSensors();
  }


  /***********************************************
                 FIREBASE UPDATE
  ************************************************/

  if (
    Firebase.ready() &&
    millis() - lastFirebase
    >= FIREBASE_INTERVAL
  )
  {
    lastFirebase =
        millis();

    sendFirebase();

    readRelayFirebase();
  }


  /***********************************************
                    OLED UPDATE
  ************************************************/

  if (
    millis() - lastOLED
    >= OLED_INTERVAL
  )
  {
    lastOLED =
        millis();

    updateOLED();
  }
}



