/***************************************************
                  pH CALIBRATION
***************************************************/

float phSlope = -5.70;
float phIntercept = 21.34;


/***************************************************
                     READ pH
***************************************************/

float readPH()
{
  long sum = 0;

  for (int i = 0; i < 20; i++)
  {
    sum += analogRead(PH_PIN);
    delay(5);
  }

  float average = sum / 20.0;

  float voltage =
      average * (3.3 / 4095.0);

  float ph =
      phSlope * voltage + phIntercept;

  if (ph < 0)
    ph = 0;

  if (ph > 14)
    ph = 14;

  return ph;
}


/***************************************************
                  WIFI CONNECT
***************************************************/

void connectWiFi()
{
  Serial.println();
  Serial.println("=================================");
  Serial.println("        WIFI CONNECTION");
  Serial.println("=================================");

  WiFi.mode(WIFI_STA);

  WiFi.begin(
    WIFI_SSID,
    WIFI_PASS
  );

  Serial.print("Connecting to: ");
  Serial.println(WIFI_SSID);

  int attempts = 0;

  while (WiFi.status() != WL_CONNECTED)
  {
    delay(500);

    Serial.print(".");

    attempts++;

    if (attempts >= 60)
    {
      Serial.println();
      Serial.println("WiFi connection failed.");
      Serial.println("Restarting...");

      ESP.restart();
    }
  }

  Serial.println();
  Serial.println("WiFi Connected!");

  Serial.print("IP Address: ");
  Serial.println(WiFi.localIP());

  Serial.print("RSSI: ");
  Serial.print(WiFi.RSSI());
  Serial.println(" dBm");
}


/***************************************************
                    READ SENSORS
***************************************************/

void readSensors()
{
  float t = dht.readTemperature();
  float h = dht.readHumidity();

  if (!isnan(t))
  {
    temperature = t;
  }
  else
  {
    Serial.println("DHT11 temperature error");
  }

  if (!isnan(h))
  {
    humidity = h;
  }
  else
  {
    Serial.println("DHT11 humidity error");
  }

  phValue = readPH();

  Serial.println();
  Serial.println("--------------------------------");

  Serial.print("Temperature : ");
  Serial.print(temperature, 1);
  Serial.println(" C");

  Serial.print("Humidity    : ");
  Serial.print(humidity, 1);
  Serial.println(" %");

  Serial.print("pH          : ");
  Serial.println(phValue, 2);

  Serial.println("--------------------------------");
}


/***************************************************
                 SET RELAY OUTPUT
***************************************************/

void setRelay(int index, bool state)
{
  if (index < 0 || index >= 5)
    return;

  relayState[index] = state;

  /*
     Active LOW relay

     LOW  = ON
     HIGH = OFF
  */

  digitalWrite(
    relayPins[index],
    state ? LOW : HIGH
  );
}


/***************************************************
               FIREBASE SEND SENSOR
***************************************************/

void sendFirebase()
{
  Serial.println();
  Serial.println("========== FIREBASE UPDATE ==========");

  if (!Firebase.ready())
  {
    Serial.println("Firebase NOT READY");

    Serial.print("WiFi status: ");
    Serial.println(WiFi.status());

    Serial.println("====================================");

    return;
  }


  /***********************************************
                  TEMPERATURE
  ************************************************/

  if (Firebase.RTDB.setFloat(
        &fbdo,
        "/sensor/temp",
        temperature))
  {
    Serial.print("Temperature OK: ");
    Serial.println(temperature);
  }
  else
  {
    Serial.print("Temperature FAILED: ");
    Serial.println(fbdo.errorReason());
  }


  /***********************************************
                    HUMIDITY
  ************************************************/

  if (Firebase.RTDB.setFloat(
        &fbdo,
        "/sensor/hum",
        humidity))
  {
    Serial.print("Humidity OK: ");
    Serial.println(humidity);
  }
  else
  {
    Serial.print("Humidity FAILED: ");
    Serial.println(fbdo.errorReason());
  }


  /***********************************************
                       pH
  ************************************************/

  if (Firebase.RTDB.setFloat(
        &fbdo,
        "/sensor/ph",
        phValue))
  {
    Serial.print("pH OK: ");
    Serial.println(phValue);
  }
  else
  {
    Serial.print("pH FAILED: ");
    Serial.println(fbdo.errorReason());
  }


  /***********************************************
                       HISTORY
  ************************************************/

  time_t now;

  time(&now);

  String timestamp;

  if (now > 100000)
  {
    timestamp =
        String((unsigned long)now);
  }
  else
  {
    timestamp =
        String(millis());
  }


  String path =
      "/history/" + timestamp;


  /***********************************************
                HISTORY TEMPERATURE
  ************************************************/

  if (Firebase.RTDB.setFloat(
        &fbdo,
        path + "/temp",
        temperature))
  {
    Serial.println("History temperature OK");
  }
  else
  {
    Serial.print("History temperature FAILED: ");
    Serial.println(fbdo.errorReason());
  }


  /***********************************************
                  HISTORY HUMIDITY
  ************************************************/

  if (Firebase.RTDB.setFloat(
        &fbdo,
        path + "/hum",
        humidity))
  {
    Serial.println("History humidity OK");
  }
  else
  {
    Serial.print("History humidity FAILED: ");
    Serial.println(fbdo.errorReason());
  }


  /***********************************************
                     HISTORY pH
  ************************************************/

  if (Firebase.RTDB.setFloat(
        &fbdo,
        path + "/ph",
        phValue))
  {
    Serial.println("History pH OK");
  }
  else
  {
    Serial.print("History pH FAILED: ");
    Serial.println(fbdo.errorReason());
  }


  Serial.println("====================================");
}


