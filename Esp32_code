    );
  }


  /***********************************************
                    RELAY 4
  ************************************************/

  if (Firebase.RTDB.getBool(
        &fbdo,
        "/control/relay4"))
  {
    relayState[3] =
        fbdo.boolData();

    setRelay(
      3,
      relayState[3]
    );
  }


  /***********************************************
                    RELAY 5
  ************************************************/

  if (Firebase.RTDB.getBool(
        &fbdo,
        "/control/relay5"))
  {
    relayState[4] =
        fbdo.boolData();

    setRelay(
      4,
      relayState[4]
    );
  }


  /***********************************************
                    AUTO MIST
  ************************************************/

  if (Firebase.RTDB.getBool(
        &fbdo,
        "/control/autoMist"))
  {
    autoMist =
        fbdo.boolData();
  }


  /***********************************************
                AUTOMATIC MISTING
